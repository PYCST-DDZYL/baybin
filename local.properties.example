# 复制本文件为 local.properties，在下面 qwen.apiKey= 后面填你自己的千问密钥。
# 仓库里没有密钥。local.properties 被 Git 忽略，不会上传。
# Copy this file to local.properties and put your own key after qwen.apiKey=

# Qwen (Alibaba Cloud Model Studio / DashScope), OpenAI-compatible endpoint.
# Base URL depends on the region your API key belongs to:
#   Beijing : https://dashscope.aliyuncs.com/compatible-mode/v1
#   Virginia: https://dashscope-us.aliyuncs.com/compatible-mode/v1
#   Singapore/HK/Tokyo workspaces: copy the URL shown in your Model Studio console.
qwen.apiKey=
qwen.baseUrl=https://dashscope.aliyuncs.com/compatible-mode/v1
qwen.model=qwen3-vl-flash
